      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(riot_snapshot_deliveries_total[1m])) / clamp_min(sum(riot_players), 1)",
          "legendFormat": "Delivered",
          "refId": "A",
          "instant": false
